#!/bin/bash

# ============================================================
# Configuration
# ============================================================

SUNSHINE_LOG="$HOME/.config/sunshine/sunshine.log"
SCREENPROFILERCMD="$HOME/.local/bin/screenprofilercmd"

# ============================================================
# Résolution
# ============================================================

resolution=$(
    grep "mode --" "$SUNSHINE_LOG" |
    tail -n 1 |
    awk -F"mode --" '{print $2}' |
    sed 's/^[[:space:]]*//' |
    grep -oE '^[0-9]+x[0-9]+'
)

if [ -z "$resolution" ]; then
    echo "Impossible de déterminer la résolution." >&2
    exit 1
fi

echo "Dernière résolution associée à 'mode --' : $resolution"

# ============================================================
# MangoHud - FPS limit
# ============================================================

if [[ "$resolution" == "1920x1200" || "$resolution" == "1280x800" ]]; then
    sed -i 's/^fps_limit=.*/fps_limit=90,0/' "$HOME/.config/MangoHud/MangoHud.conf"
    echo "MangoHud : fps_limit=90,0"
else
    sed -i 's/^fps_limit=.*/fps_limit=120,0/' "$HOME/.config/MangoHud/MangoHud.conf"
    echo "MangoHud : fps_limit=120,0"
fi

# ============================================================
# Charger le profil
# ============================================================

echo
echo "Chargement du profil : $resolution"

"$SCREENPROFILERCMD" load "$resolution"

exit $?