#!/bin/bash

# Chemin vers le fichier de log (à adapter selon la configuration de votre système)
SUNSHINE_LOG="$HOME/.config/sunshine/sunshine.log"

# Extraction du mode de résolution (dernière occurrence)
resolution=$(grep -m 1 "mode --" "$SUNSHINE_LOG" | tail -n 1 | awk -F"mode --" '{print $2}' | awk -F'x' '{print $1 "x" $2}')

# Affichage de la valeur associée à 'mode --'
echo "Dernière valeur associée à 'mode --' dans $SUNSHINE_LOG : $resolution"

# Update fps_limit based on resolution
if [[ "$resolution" == "1920x1200" || "$resolution" == "1280x800" ]]; then
  sed -i 's/^fps_limit=.*/fps_limit=90,0/' ~/.config/MangoHud/MangoHud.conf
else
  sed -i 's/^fps_limit=.*/fps_limit=120,0/' ~/.config/MangoHud/MangoHud.conf
fi

# Launch the program with the resolution as an argument
for i in {1..2}; do
  $HOME/.local/bin/screenprofilercmd load $resolution 0
done

